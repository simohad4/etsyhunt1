# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APIFY_TOKEN: Apify API token for live scraping using yumitori/etsy-listings-scraper.
# Optional for interactive testing (intelligent high-fidelity mock fallback provided if not supplied).
APIFY_TOKEN="MY_APIFY_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Client Configuration
# Optional: If configured, the app will connect directly to your live Supabase project.
# If not configured, an intelligent offline local Supabase auth & multi-tenant simulation is used seamlessly.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
