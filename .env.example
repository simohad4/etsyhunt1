# GEMINI_API_KEY: Required for Gemini API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=your-gemini-api-key

# APIFY_TOKEN: Apify API token for live scraping using yumitori/etsy-listings-scraper.
# Keep empty or mock for safe local testing.
APIFY_TOKEN=your-apify-token

# ENABLE_LIVE_SCRAPING: Safety gate for live paid scraping.
# Defaults to false in M1 to prevent unauthorized charges until auth & rate limiting are locked in M2.
ENABLE_LIVE_SCRAPING="false"

# APP_URL: The URL where this applet is hosted.
APP_URL=http://localhost:3000

# Supabase Client Configuration (Vite client-side variables)
# Required for live Supabase Auth and PostgreSQL integration.
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Supabase Server-side Service Role Key (Backend only - NEVER expose with VITE_ prefix)
# Used exclusively for webhook processing, subscription grants, and maintenance tasks.
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
